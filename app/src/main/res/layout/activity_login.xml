<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F8F7"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- LOGO -->
        <TextView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:gravity="center"
            android:background="@drawable/bg_login_logo"
            android:elevation="4dp"
            android:text="LH"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <!-- TEN UNG DUNG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Quản lý lịch hẹn"
            android:textColor="#173C38"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sắp xếp thời gian, làm chủ mỗi ngày"
            android:textColor="#78908B"
            android:textSize="14sp"/>

        <!-- KHUNG DANG NHAP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_login_round"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chào mừng trở lại!"
                android:textColor="#173C38"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Đăng nhập để xem lịch hẹn của bạn"
                android:textColor="#78908B"
                android:textSize="13sp"/>

            <!-- TEN DANG NHAP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Tên đăng nhập"
                android:textColor="#234742"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập tên đăng nhập"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#173C38"
                android:textColorHint="#94A7A2"
                android:textSize="14sp"
                android:inputType="text"
                android:singleLine="true"
                android:autofillHints="username"/>

            <!-- MAT KHAU -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Mật khẩu"
                android:textColor="#234742"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập mật khẩu"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#173C38"
                android:textColorHint="#94A7A2"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="password"/>

            <!-- THONG BAO LOI -->
            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Sai tên đăng nhập hoặc mật khẩu"
                android:textColor="#D63C43"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- NUT DANG NHAP -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:gravity="center"
                android:textAlignment="center"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- TAI KHOAN MAU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Tài khoản mẫu: admin / 123456"
            android:textColor="#78908B"
            android:textSize="13sp"/>

        <!-- THONG TIN PHIEN BAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="Quản lý lịch hẹn • Phiên bản 1.0"
            android:textColor="#A0B2AD"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
